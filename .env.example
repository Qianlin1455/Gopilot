# Native-process defaults. Docker Compose supplies its own internal service URL
# and listen addresses; only the LLM_* values below are passed to GoPilot.
DEMO_SERVICE_URL=http://localhost:8081
GOPILOT_ADDR=:8080

# Leave all three values empty to run the observable demo without an Agent.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_THINKING=

# Verified DeepSeek-compatible example (choose an available tool-capable model):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=replace-with-your-key
# LLM_MODEL=deepseek-flash
# LLM_THINKING=disabled
# DeepSeek thinking mode does not support tool_choice: required. GoPilot keeps
# tool_choice required, so explicitly disable thinking for DeepSeek. Leave
# LLM_THINKING empty for providers that do not support this extension.
