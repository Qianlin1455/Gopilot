DEMO_SERVICE_URL=http://localhost:8081
GOPILOT_ADDR=:8080

# OpenAI-compatible Chat Completions configuration.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# DeepSeek thinking mode does not support tool_choice: required. Keep this
# disabled for DeepSeek; remove LLM_THINKING entirely for providers that do not
# support the provider-specific thinking field.
LLM_THINKING=disabled
